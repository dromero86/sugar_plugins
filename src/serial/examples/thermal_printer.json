{
  "task": [
    {
      "print": {
        "text": "=== Comunicación con Impresora Térmica ==="
      }
    },
    {
      "serial": {
        "operator": "connect",
        "port": "COM7",
        "baudrate": 9600,
        "session": "thermal_printer",
        "timeout": 2.0,
        "id": "printer_connection"
      }
    },
    {
      "print": {
        "text": "Conexión a impresora: {{printer_connection}}"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "thermal_printer",
        "data": "\\x1B\\x40",
        "encoding": "binary",
        "id": "init_cmd"
      }
    },
    {
      "print": {
        "text": "Comando de inicialización enviado"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "thermal_printer",
        "data": "\\x1B\\x61\\x01",
        "encoding": "binary",
        "id": "center_cmd"
      }
    },
    {
      "print": {
        "text": "Comando de centrado enviado"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "thermal_printer",
        "data": "TICKET DE VENTA\\r\\n",
        "id": "text_cmd"
      }
    },
    {
      "print": {
        "text": "Texto enviado a impresora"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "thermal_printer",
        "data": "\\x1D\\x56\\x00",
        "encoding": "binary",
        "id": "cut_cmd"
      }
    },
    {
      "print": {
        "text": "Comando de corte enviado"
      }
    },
    {
      "serial": {
        "operator": "disconnect",
        "session": "thermal_printer"
      }
    },
    {
      "print": {
        "text": "Desconectado de impresora"
      }
    }
  ]
}