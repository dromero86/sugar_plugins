{
  "meta": {
    "serial": {
      "options": {
        "device_1": {
          "port": "COM3",
          "baudrate": 115200,
          "auto_connect": true
        },
        "device_2": {
          "port": "COM4",
          "baudrate": 9600,
          "auto_connect": true
        },
        "device_3": {
          "port": "COM5",
          "baudrate": 57600,
          "auto_connect": false
        }
      }
    }
  },
  "task": [
    {
      "print": {
        "text": "=== Ejemplo de Múltiples Sesiones Serie ==="
      }
    },
    {
      "serial": {
        "operator": "get_status",
        "id": "all_sessions_status"
      }
    },
    {
      "print": {
        "text": "Estado de todas las sesiones: {{all_sessions_status}}"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "device_1",
        "data": "STATUS\\r\\n",
        "id": "device1_write"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "device_2",
        "data": "VERSION\\r\\n",
        "id": "device2_write"
      }
    },
    {
      "serial": {
        "operator": "connect",
        "session": "device_3",
        "id": "device3_connect"
      }
    },
    {
      "print": {
        "text": "Conexión device_3: {{device3_connect}}"
      }
    },
    {
      "serial": {
        "operator": "write",
        "session": "device_3",
        "data": "INFO\\r\\n",
        "id": "device3_write"
      }
    },
    {
      "serial": {
        "operator": "read_line",
        "session": "device_1",
        "timeout": 2.0,
        "id": "device1_response"
      }
    },
    {
      "serial": {
        "operator": "read_line",
        "session": "device_2",
        "timeout": 2.0,
        "id": "device2_response"
      }
    },
    {
      "serial": {
        "operator": "read_line",
        "session": "device_3",
        "timeout": 2.0,
        "id": "device3_response"
      }
    },
    {
      "print": {
        "text": "Respuesta device_1: {{device1_response}}"
      }
    },
    {
      "print": {
        "text": "Respuesta device_2: {{device2_response}}"
      }
    },
    {
      "print": {
        "text": "Respuesta device_3: {{device3_response}}"
      }
    },
    {
      "serial": {
        "operator": "get_info",
        "id": "all_sessions_info"
      }
    },
    {
      "print": {
        "text": "Información de todas las sesiones: {{all_sessions_info}}"
      }
    },
    {
      "serial": {
        "operator": "disconnect",
        "session": "device_1"
      }
    },
    {
      "serial": {
        "operator": "disconnect",
        "session": "device_2"
      }
    },
    {
      "serial": {
        "operator": "disconnect",
        "session": "device_3"
      }
    },
    {
      "print": {
        "text": "Todas las sesiones desconectadas"
      }
    }
  ]
}