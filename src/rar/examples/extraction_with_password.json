{
  "description": "Ejemplo de extracción RAR con contraseña",
  "task": [
    {
      "print": {
        "text": "Iniciando extracción RAR con contraseña..."
      }
    },
    {
      "rar": {
        "operator": "rar_extract",
        "source": "./archivo_protegido.rar",
        "destination": "./extraido",
        "password": "mi_contraseña_secreta",
        "overwrite": false,
        "result": "extraction_result"
      }
    },
    {
      "print": {
        "text": "Extracción completada: {{extraction_result.status}}"
      }
    },
    {
      "if": {
        "condition": "${extraction_result.status} == 'success'",
        "then": {
          "task": [
            {
              "print": {
                "text": "Extracción exitosa"
              }
            },
            {
              "print": {
                "text": "Directorio de destino: {{extraction_result.destination}}"
              }
            },
            {
              "print": {
                "text": "Archivos extraídos: {{extraction_result.extracted_files}}"
              }
            },
            {
              "print": {
                "text": "Tamaño extraído: {{extraction_result.extracted_size}} bytes"
              }
            },
            {
              "print": {
                "text": "⏱Tiempo de procesamiento: {{extraction_result.processing_time}}s"
              }
            }
          ]
        },
        "else": {
          "task": [
            {
              "print": {
                "text": "Error en extracción: {{extraction_result.error}}"
              }
            },
            {
              "print": {
                "text": "Verificar que la contraseña sea correcta"
              }
            }
          ]
        }
      }
    }
  ]
}
