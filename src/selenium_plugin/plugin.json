{
  "name": "selenium",
  "version": "2.1.0",
  "description": "Plugin de automatización web para Sugar con sintaxis {\"selenium\": {\"operator\": ...}}",
  "author": "Sugar Team",
  "license": "MIT",
  "main": "src/SeleniumPlugin.py",
  "class": "SeleniumPlugin",
  "dependencies": [
    "selenium>=4.0.0",
    "webdriver-manager>=3.8.0"
  ],
  "keywords": [
    "selenium",
    "webdriver",
    "automation",
    "browser",
    "testing",
    "web"
  ],
  "supported_browsers": [
    "chrome",
    "firefox", 
    "edge"
  ],
  "operators": [
    "click",
    "open",
    "javascript",
    "type",
    "wait",
    "screenshot",
    "navigate",
    "find",
    "submit",
    "clear",
    "select",
    "hover",
    "scroll",
    "upload",
    "download",
    "cookies",
    "window",
    "frame",
    "alert",
    "page",
    "state",
    "dblclick",
    "rightclick",
    "keys",
    "quit",
    "storage",
    "drag_and_drop",
    "pdf",
    "timeouts",
    "actions",
    "element",
    "shadow",
    "cdp",
    "network",
    "capabilities",
    "storage_state",
    "challenge",
    "bidi",
    "downloads"
  ],
  "features": [
    "Sintaxis unificada {\"selenium\": {\"operator\": ...}}",
    "Soporte completo de navegadores",
    "Sistema avanzado de cookies",
    "Descarga automática de drivers",
    "Gestión robusta de errores",
    "Timeouts configurables",
    "Modo headless",
    "Modo detach"
  ]
}