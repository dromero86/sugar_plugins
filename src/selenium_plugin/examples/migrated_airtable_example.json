{
  "meta": {
    "mode": "selenium",
    "browser": "chrome",
    "options": [
      "--disable-gpu",
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--window-size=1920,1080"
    ],
    "headless": true,
    "timeout": 15,
    "implicit_wait": 5
  },
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://airtable.com/login",
        "id": "login_page_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": "form",
        "id": "form_loaded"
      }
    },
    {
      "selenium": {
        "operator": "type",
        "selector": "input[name='email']",
        "value": "user@example.com",
        "id": "email_typed"
      }
    },
    {
      "selenium": {
        "operator": "type",
        "selector": "input[name='password']",
        "value": "password123",
        "id": "password_typed"
      }
    },
    {
      "selenium": {
        "operator": "submit",
        "selector": "form",
        "id": "form_submitted"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": ".dashboard",
        "id": "dashboard_loaded"
      }
    },
    {
      "selenium": {
        "operator": "cookies",
        "action": "get",
        "id": "session_cookies"
      }
    },
    {
      "selenium": {
        "operator": "open",
        "url": "https://airtable.com/app/abc123/tbl/def456",
        "id": "table_page_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": ".record-row",
        "id": "records_loaded"
      }
    },
    {
      "selenium": {
        "operator": "find",
        "selector": ".record-row",
        "multiple": true,
        "id": "all_records"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./airtable_records.png",
        "id": "screenshot_taken"
      }
    },
    {
      "selenium": {
        "operator": "click",
        "selector": ".add-record-button",
        "id": "add_button_clicked"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": ".record-form",
        "id": "form_ready"
      }
    },
    {
      "selenium": {
        "operator": "type",
        "selector": "input[name='Name']",
        "value": "Nuevo Registro",
        "id": "name_typed"
      }
    },
    {
      "selenium": {
        "operator": "type",
        "selector": "input[name='Description']",
        "value": "Descripción del nuevo registro",
        "id": "description_typed"
      }
    },
    {
      "selenium": {
        "operator": "click",
        "selector": ".save-record-button",
        "id": "record_saved"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "time",
        "seconds": 3,
        "id": "save_wait"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./airtable_new_record.png",
        "id": "final_screenshot"
      }
    }
  ]
}
