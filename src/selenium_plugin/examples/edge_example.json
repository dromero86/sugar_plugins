{
  "meta": {
    "mode": "selenium",
    "browser": "edge",
    "options": [
      "--disable-gpu",
      "--no-sandbox",
      "--disable-web-security",
      "--window-size=1280,720",
      "--disable-blink-features=AutomationControlled"
    ],
    "detach": true,
    "headless": false,
    "timeout": 10
  },
  
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://www.microsoft.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": "header",
        "id": "header_ready"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./edge_microsoft.png",
        "id": "screenshot"
      }
    },
    {
      "selenium": {
        "operator": "find",
        "selector": "a[href*='products']",
        "multiple": true,
        "id": "product_links"
      }
    },
    {
      "print": {
        "text": "Enlaces de productos encontrados: {{product_links}}"
      }
    }
  ]
}
