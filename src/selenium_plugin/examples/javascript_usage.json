{
  "meta": {
    "mode": "selenium",
    "driver": { "bin": "./driver/chromedriver" },
    "options": [
      "--disable-gpu",
      "--no-sandbox",
      "--window-size=1280,720"
    ],
    "detach": false,
    "timeout": 10
  },
  
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://www.example.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "document.title = 'Modified by Sugar Selenium';",
        "id": "title_modified"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "window.scrollTo(0, document.body.scrollHeight);",
        "id": "scrolled_to_bottom"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "return document.querySelectorAll('a').length;",
        "id": "link_count"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "return Array.from(document.querySelectorAll('a')).map(a => a.href);",
        "id": "all_links"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "localStorage.setItem('sugar_test', 'Hello from Sugar!');",
        "id": "local_storage_set"
      }
    },
    {
      "selenium": {
        "operator": "javascript",
        "from_string": "return localStorage.getItem('sugar_test');",
        "id": "local_storage_get"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./javascript_test.png",
        "id": "screenshot"
      }
    }
  ]
}
