{
  "meta": {
    "mode": "selenium",
    "browser": "firefox",
    "options": [
      "--width=1280",
      "--height=720",
      "--no-sandbox"
    ],
    "headless": false,
    "timeout": 15,
    "implicit_wait": 5
  },
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://example.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": "body",
        "id": "page_loaded"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./example_screenshot.png",
        "id": "screenshot"
      }
    },
    {
      "selenium": {
        "operator": "quit"
      }
    }
  ]
}
