{
  "meta": {
    "mode": "selenium",
    "browser": "chrome",
    "headless": true,
    "timeout": 10,
    "implicit_wait": 5
  },
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://www.google.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "time",
        "seconds": 2,
        "id": "is_waited"
      }
    },
    {
      "selenium": {
        "operator": "type",
        "selector": "input[name='q']",
        "value": "Sugar automation",
        "id": "is_typed"
      }
    },
    {
      "selenium": {
        "operator": "click",
        "selector": "input[name='btnK']",
        "id": "is_clicked"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": "#search",
        "id": "search_loaded"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./google_result.png",
        "id": "screenshot"
      }
    }
  ]
}
