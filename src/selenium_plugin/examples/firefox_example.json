{
  "meta": {
    "mode": "selenium",
    "browser": "firefox",
    "options": [
      "--width=1920",
      "--height=1080",
      "--no-sandbox"
    ],
    "headless": true,
    "timeout": 15,
    "implicit_wait": 5
  },
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://example.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "element",
        "selector": "body",
        "id": "page_loaded"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./firefox_screenshot.png",
        "id": "screenshot"
      }
    },
    {
      "selenium": {
        "operator": "find",
        "selector": "h1",
        "id": "title"
      }
    },
    {
      "selenium": {
        "operator": "navigate",
        "action": "refresh",
        "id": "refreshed"
      }
    }
  ]
}
