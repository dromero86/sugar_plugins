{
  "meta": {
    "mode": "selenium",
    "browser": "opera",
    "options": [
      "--disable-gpu",
      "--no-sandbox",
      "--disable-web-security",
      "--window-size=1280,720"
    ],
    "detach": true,
    "headless": false,
    "timeout": 10
  },
  
  "task": [
    {
      "selenium": {
        "operator": "open",
        "url": "https://www.opera.com",
        "id": "is_open"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "time",
        "seconds": 3,
        "id": "is_waited"
      }
    },
    {
      "selenium": {
        "operator": "screenshot",
        "file": "./opera_homepage.png",
        "id": "screenshot"
      }
    },
    {
      "selenium": {
        "operator": "find",
        "selector": ".download-button",
        "id": "download_button"
      }
    },
    {
      "selenium": {
        "operator": "click",
        "selector": ".download-button",
        "id": "download_clicked"
      }
    },
    {
      "selenium": {
        "operator": "wait",
        "type": "time",
        "seconds": 2,
        "id": "download_wait"
      }
    },
    {
      "print": {
        "text": "Opera homepage visitada exitosamente"
      }
    }
  ]
}
