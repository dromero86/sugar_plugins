[
  {
    "jwt": {
      "operator": "encode",
      "payload": {
        "sub": "1234567890",
        "name": "{{ nombre|default('Usuario Anónimo') }}",
        "iat": "{{ timestamp }}",
        "exp": "{{ timestamp + 3600 }}"
      },
      "key": "{{ secret_key }}",
      "algorithm": "HS256",
      "id": "encoded_jwt"
    }
  },
  {
    "jwt": {
      "operator": "decode",
      "token": "{{ encoded_jwt }}",
      "key": "{{ secret_key }}",
      "algorithms": ["HS256"],
      "verify": true,
      "id": "decoded_payload"
    }
  },
  {
    "jwt": {
      "operator": "verify",
      "token": "{{ token_input }}",
      "key": "{{ public_key }}",
      "algorithms": ["RS256"],
      "id": "is_valid"
    }
  },
  {
    "jwt": {
      "operator": "decode",
      "token": "{{ token_input }}",
      "options": {
        "verify_signature": false
      },
      "id": "payload_unverified"
    }
  }
]