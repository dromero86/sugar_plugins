{
  "task": [
    {
      "docker": {
        "operator": "create_composition",
        "name": "web_app",
        "version": "3.8",
        "services": {
          "web": {
            "image": "nginx:alpine",
            "ports": ["80:80"],
            "environment": {
              "NGINX_HOST": "localhost",
              "NGINX_PORT": "80"
            },
            "volumes": ["./web:/usr/share/nginx/html"],
            "networks": ["web_network"],
            "restart": "unless-stopped",
            "labels": {
              "app": "web",
              "environment": "development"
            }
          },
          "database": {
            "image": "postgres:13-alpine",
            "ports": ["5432:5432"],
            "environment": {
              "POSTGRES_DB": "myapp",
              "POSTGRES_USER": "user",
              "POSTGRES_PASSWORD": "password"
            },
            "volumes": ["postgres_data:/var/lib/postgresql/data"],
            "networks": ["web_network"],
            "restart": "unless-stopped",
            "depends_on": [],
            "labels": {
              "app": "database",
              "environment": "development"
            }
          },
          "redis": {
            "image": "redis:alpine",
            "ports": ["6379:6379"],
            "volumes": ["redis_data:/data"],
            "networks": ["web_network"],
            "restart": "unless-stopped",
            "labels": {
              "app": "cache",
              "environment": "development"
            }
          }
        },
        "networks": {
          "web_network": {
            "driver": "bridge",
            "labels": {
              "app": "web_app"
            }
          }
        },
        "volumes": {
          "postgres_data": {
            "driver": "local",
            "labels": {
              "app": "database"
            }
          },
          "redis_data": {
            "driver": "local",
            "labels": {
              "app": "cache"
            }
          }
        },
        "id": "composition_result"
      }
    },
    {
      "print": {
        "text": "Composición creada: {{composition_result}}"
      }
    },
    {
      "docker": {
        "operator": "start_composition",
        "name": "web_app",
        "id": "start_result"
      }
    },
    {
      "print": {
        "text": "Composición iniciada: {{start_result}}"
      }
    },
    {
      "docker": {
        "operator": "status_composition",
        "name": "web_app",
        "id": "status_result"
      }
    },
    {
      "print": {
        "text": "Estado de la composición: {{status_result}}"
      }
    }
  ]
}